<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notification_choice"
    android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="1dp"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:background="@drawable/notification_choice">
    <TextView android:id="@+id/notification_choice_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textStyle="bold" android:textColor="#E6EDF3" />
    <TextView android:id="@+id/notification_choice_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="#9BAABB" />
</LinearLayout>
